# Server
PORT=4000
NODE_ENV=development

# Database
MONGO_URI=mongodb://127.0.0.1:27017/easycater

# Auth (CHANGE THESE IN PRODUCTION)
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# CORS - comma separated list of allowed origins
CORS_ORIGIN=http://localhost:8100,http://localhost:8101,http://localhost:4200

# Seed admin account
SEED_ADMIN_EMAIL=admin@easycater.com
SEED_ADMIN_PASSWORD=Admin123!
